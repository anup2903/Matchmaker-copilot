# Single-image backend for hosts that build from the repo root (e.g. Render).
# Local dev uses backend/Dockerfile + docker-compose instead.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ /app/
COPY seed/ /seed/

# migrate -> seed (only if empty) -> serve
CMD ["sh", "-c", "alembic upgrade head && python /seed/seed.py --if-empty && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
